{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "AbilityPower": {
      "type": "string",
      "enum": [
        "flames",
        "armour",
        "halt",
        "reverse",
        "fortune"
      ],
      "description": "Ocular Awakening's flames or armour, Time Warp's halt or reverse, Card Gamble's \"fortune\" (thrown for cards)."
    },
    "CardId": {
      "type": "string",
      "enum": [
        "windStep",
        "healingHerb",
        "arcaneShield",
        "ancientScroll",
        "luckyCharm",
        "berserkFury",
        "oracleEye",
        "arcaneBlast",
        "blindingFlash",
        "mysticGate",
        "fateRune",
        "ancestralAwakening",
        "fateSwap",
        "abyssCall",
        "celestialLight",
        "heavenlyAegis",
        "ascension",
        "blindJustice",
        "confiscation",
        "justiceMark",
        "containmentDecree",
        "finalJudgment",
        "hotBlood",
        "emberStep",
        "scarletFever",
        "pureFuel",
        "scarletSupernova",
        "voidHunger",
        "hungryRift",
        "voidEcho",
        "riftCall",
        "tectonicFortification",
        "riptideLash",
        "forcedTailwind",
        "elementalExchange",
        "elementalConvergence"
      ]
    },
    "ClosedMessage": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "closed"
        },
        "to": {
          "type": "string"
        },
        "reason": {
          "type": "string",
          "enum": [
            "HOST_CLOSED",
            "SEAT_RELEASED"
          ],
          "description": "HOST_CLOSED: the match ended for everyone; SEAT_RELEASED: the host freed this client's seat."
        }
      },
      "required": [
        "type",
        "to",
        "reason"
      ],
      "additionalProperties": false
    },
    "CommandMessage": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "command"
        },
        "clientId": {
          "type": "string"
        },
        "requestId": {
          "type": "integer",
          "description": "Echoed in the result so the controller can match it to its pending send."
        },
        "command": {
          "$ref": "#/definitions/GameCommand"
        }
      },
      "required": [
        "type",
        "clientId",
        "requestId",
        "command"
      ],
      "additionalProperties": false
    },
    "CommandResult": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean",
              "const": true
            }
          },
          "required": [
            "ok"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean",
              "const": false
            },
            "code": {
              "$ref": "#/definitions/GameErrorCode"
            }
          },
          "required": [
            "ok",
            "code"
          ],
          "additionalProperties": false
        }
      ],
      "description": "Plain data, not an Error subclass: it has to survive a JSON trip from the server."
    },
    "CommandResultMessage": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "commandResult"
        },
        "to": {
          "type": "string"
        },
        "requestId": {
          "type": "integer"
        },
        "result": {
          "$ref": "#/definitions/WireCommandResult"
        }
      },
      "required": [
        "type",
        "to",
        "requestId",
        "result"
      ],
      "additionalProperties": false
    },
    "ControllerMessage": {
      "anyOf": [
        {
          "$ref": "#/definitions/JoinMessage"
        },
        {
          "$ref": "#/definitions/CommandMessage"
        },
        {
          "$ref": "#/definitions/ResyncMessage"
        },
        {
          "$ref": "#/definitions/LeaveMessage"
        }
      ]
    },
    "Element": {
      "type": "string",
      "enum": [
        "earth",
        "water",
        "fire",
        "wind"
      ],
      "description": "Tenzai's four bendings; each one used for the first time joins his orbit (Primordial Awakening)."
    },
    "GameCommand": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "rollDice"
            },
            "playerId": {
              "$ref": "#/definitions/PlayerId"
            }
          },
          "required": [
            "type",
            "playerId"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "forfeitTurn"
            },
            "playerId": {
              "$ref": "#/definitions/PlayerId"
            }
          },
          "required": [
            "type",
            "playerId"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "playCard"
            },
            "playerId": {
              "$ref": "#/definitions/PlayerId"
            },
            "cardUid": {
              "type": "string"
            },
            "targetId": {
              "$ref": "#/definitions/PlayerId"
            },
            "value": {
              "type": "number"
            },
            "sacrificeUids": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Hand cards burnt to pay for a card that asks for them (see CardDefinition.sacrifices)."
            },
            "element": {
              "$ref": "#/definitions/Element",
              "description": "What Tenzai's Elemental Exchange turns into."
            }
          },
          "required": [
            "type",
            "playerId",
            "cardUid"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "discardCard"
            },
            "playerId": {
              "$ref": "#/definitions/PlayerId"
            },
            "cardUid": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "playerId",
            "cardUid"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "sacrificeEnergy"
            },
            "playerId": {
              "$ref": "#/definitions/PlayerId"
            }
          },
          "required": [
            "type",
            "playerId"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "fuseCards"
            },
            "playerId": {
              "$ref": "#/definitions/PlayerId"
            },
            "cardId": {
              "$ref": "#/definitions/CardId"
            }
          },
          "required": [
            "type",
            "playerId",
            "cardId"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "activateAbility"
            },
            "playerId": {
              "$ref": "#/definitions/PlayerId"
            },
            "cardUids": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Hand cards (Transmutation) or discard pile cards (Resurrection)."
            },
            "sealTiles": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/TileId"
              },
              "description": "In SEAL_KINDS order."
            },
            "specterTiles": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/TileId"
              },
              "description": "In SPECTER_KINDS order."
            },
            "targetId": {
              "$ref": "#/definitions/PlayerId",
              "description": "Card Gamble (random when absent), Time Warp and Hell's Drag."
            },
            "volley": {
              "type": "string",
              "enum": [
                "opponents",
                "traps"
              ],
              "description": "Arrow Rain; traps by default."
            },
            "power": {
              "$ref": "#/definitions/AbilityPower",
              "description": "Ocular Awakening, Time Warp and Card Gamble's pick."
            },
            "flameTiles": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/TileId"
              }
            },
            "frostTiles": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/TileId"
              },
              "description": "Crystal Fairy once Eternal Winter has begun."
            },
            "seizeTile": {
              "$ref": "#/definitions/TileId",
              "description": "Zarek's Void, idle long enough: the tile whose spell it takes over."
            },
            "element": {
              "$ref": "#/definitions/Element",
              "description": "Tenzai's bending; earth also needs `wallTile`, water a `targetId`."
            },
            "wallTile": {
              "$ref": "#/definitions/TileId"
            }
          },
          "required": [
            "type",
            "playerId"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "placeVoid"
            },
            "playerId": {
              "$ref": "#/definitions/PlayerId"
            },
            "index": {
              "type": "number"
            },
            "tile": {
              "$ref": "#/definitions/TileId"
            },
            "doubled": {
              "type": "boolean"
            }
          },
          "required": [
            "type",
            "playerId",
            "index",
            "tile"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "plunderCards"
            },
            "playerId": {
              "$ref": "#/definitions/PlayerId"
            },
            "cardUids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "type",
            "playerId",
            "cardUids"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "answerWard"
            },
            "playerId": {
              "$ref": "#/definitions/PlayerId"
            },
            "use": {
              "type": "boolean"
            }
          },
          "required": [
            "type",
            "playerId",
            "use"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "chooseGrace"
            },
            "playerId": {
              "$ref": "#/definitions/PlayerId"
            },
            "blessing": {
              "$ref": "#/definitions/TimedBlessing"
            },
            "cardId": {
              "$ref": "#/definitions/CardId"
            }
          },
          "required": [
            "type",
            "playerId"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "restart"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        }
      ]
    },
    "GameErrorCode": {
      "type": "string",
      "enum": [
        "NOT_YOUR_TURN",
        "GAME_FINISHED",
        "UNKNOWN_PLAYER",
        "DISCARD_PENDING",
        "NO_DISCARD_PENDING",
        "UNKNOWN_CARD",
        "CARD_ALREADY_PLAYED",
        "NOT_ENOUGH_ENERGY",
        "ALREADY_SHIELDED",
        "DICE_BOOST_ACTIVE",
        "INVALID_TARGET",
        "INVALID_VALUE",
        "NO_PORTAL_AHEAD",
        "NO_HELL",
        "WARD_PENDING",
        "NO_WARD_PENDING",
        "NO_ABILITY",
        "CANNOT_FUSE",
        "ABILITY_REACTIVE",
        "ABILITY_NOT_READY",
        "ENERGY_FULL",
        "ABILITY_ALREADY_READY",
        "EMPTY_HAND",
        "EMPTY_DISCARD",
        "HAND_FULL",
        "NO_CARDS_LEFT",
        "TOO_MANY_CARDS",
        "INVALID_SEALS",
        "SILENCED",
        "INVALID_SPECTERS",
        "INVALID_FLAMES",
        "INVALID_FROST",
        "PLUNDER_PENDING",
        "NO_PLUNDER_PENDING",
        "GRACE_PENDING",
        "NO_GRACE_PENDING",
        "INVALID_GRACE",
        "VOID_FULL",
        "INVALID_VOID",
        "VOID_EMPTY",
        "NO_HARM_AHEAD",
        "NOT_YOUR_CARD",
        "NO_SACRIFICE",
        "INVALID_SACRIFICE",
        "NO_INNER_FLAME",
        "NO_FIRE",
        "INVALID_ELEMENT",
        "ELEMENT_LOCKED",
        "INVALID_WALL",
        "NO_TARGET_AHEAD",
        "NO_CREATION"
      ]
    },
    "GameUpdateMessage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state": {
          "$ref": "#/definitions/OpaqueJson"
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/OpaqueJson"
          }
        },
        "seq": {
          "type": "integer"
        }
      },
      "required": [
        "events",
        "seq",
        "state"
      ]
    },
    "HostErrorCode": {
      "type": "string",
      "enum": [
        "NOT_SEATED",
        "NOT_YOUR_SEAT",
        "RESTART_NOT_ALLOWED"
      ],
      "description": "Refusals decided by the host before the rules run; never reach the domain."
    },
    "JoinMessage": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "join"
        },
        "clientId": {
          "type": "string"
        },
        "role": {
          "type": "string",
          "enum": [
            "player",
            "spectator"
          ],
          "description": "\"spectator\" sees no secrets and sends no commands (the TV, or a phone still picking a seat)."
        },
        "seat": {
          "$ref": "#/definitions/PlayerId",
          "description": "Omitted: the seat this client already holds, else the first free one."
        },
        "name": {
          "type": "string",
          "description": "Shown to the table in presence."
        },
        "character": {
          "type": "string",
          "description": "The character the player wants; only a hint for a future pre-game lobby, the seats are fixed today."
        }
      },
      "required": [
        "type",
        "clientId",
        "role"
      ],
      "additionalProperties": false
    },
    "JoinRefusal": {
      "type": "string",
      "enum": [
        "ROOM_FULL",
        "SEAT_TAKEN",
        "UNKNOWN_SEAT"
      ]
    },
    "JoinRefusedMessage": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "joinRefused"
        },
        "to": {
          "type": "string"
        },
        "reason": {
          "$ref": "#/definitions/JoinRefusal"
        }
      },
      "required": [
        "type",
        "to",
        "reason"
      ],
      "additionalProperties": false
    },
    "LeaveMessage": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "leave"
        },
        "clientId": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "clientId"
      ],
      "additionalProperties": false
    },
    "OpaqueJson": {
      "type": "object",
      "additionalProperties": {},
      "description": "GameState and GameEvent go through the server untouched, so the schema only promises a JSON object."
    },
    "PartyHostMessage": {
      "anyOf": [
        {
          "$ref": "#/definitions/PartySnapshotMessage"
        },
        {
          "$ref": "#/definitions/JoinRefusedMessage"
        },
        {
          "$ref": "#/definitions/PartyUpdateMessage"
        },
        {
          "$ref": "#/definitions/CommandResultMessage"
        },
        {
          "$ref": "#/definitions/PresenceMessage"
        },
        {
          "$ref": "#/definitions/ClosedMessage"
        }
      ]
    },
    "PartySnapshotMessage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state": {
          "$ref": "#/definitions/OpaqueJson"
        },
        "type": {
          "type": "string",
          "const": "snapshot"
        },
        "to": {
          "type": "string"
        },
        "seq": {
          "type": "integer"
        },
        "localPlayerId": {
          "anyOf": [
            {
              "$ref": "#/definitions/PlayerId"
            },
            {
              "type": "null"
            }
          ],
          "description": "null = spectator."
        }
      },
      "required": [
        "localPlayerId",
        "seq",
        "state",
        "to",
        "type"
      ]
    },
    "PartyUpdateMessage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state": {
          "$ref": "#/definitions/OpaqueJson"
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/OpaqueJson"
          }
        },
        "type": {
          "type": "string",
          "const": "update"
        },
        "to": {
          "type": "string"
        },
        "seq": {
          "type": "integer"
        }
      },
      "required": [
        "events",
        "seq",
        "state",
        "to",
        "type"
      ]
    },
    "PlayerId": {
      "type": "string"
    },
    "PresenceMessage": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "presence"
        },
        "to": {
          "type": "string"
        },
        "seats": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/SeatPresence"
          }
        },
        "spectators": {
          "type": "integer"
        }
      },
      "required": [
        "type",
        "to",
        "seats",
        "spectators"
      ],
      "additionalProperties": false,
      "description": "Sent to every client whenever someone joins or leaves."
    },
    "ResyncMessage": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "resync"
        },
        "clientId": {
          "type": "string"
        },
        "sinceSeq": {
          "type": "integer",
          "description": "The last seq this controller applied; the host replays what follows or sends a fresh snapshot."
        }
      },
      "required": [
        "type",
        "clientId",
        "sinceSeq"
      ],
      "additionalProperties": false
    },
    "SeatPresence": {
      "type": "object",
      "properties": {
        "playerId": {
          "$ref": "#/definitions/PlayerId"
        },
        "playerName": {
          "type": "string",
          "description": "The in-game player name."
        },
        "controllerName": {
          "type": [
            "string",
            "null"
          ],
          "description": "Who holds the seat (their join name), null while free."
        },
        "character": {
          "type": [
            "string",
            "null"
          ],
          "description": "Hint sent by the controller holding the seat."
        }
      },
      "required": [
        "playerId",
        "playerName",
        "controllerName",
        "character"
      ],
      "additionalProperties": false
    },
    "SnapshotMessage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state": {
          "$ref": "#/definitions/OpaqueJson"
        },
        "seq": {
          "type": "integer"
        },
        "localPlayerId": {
          "anyOf": [
            {
              "$ref": "#/definitions/PlayerId"
            },
            {
              "type": "null"
            }
          ],
          "description": "The seat this screen plays; null = hot-seat, whoever must act plays here."
        }
      },
      "required": [
        "localPlayerId",
        "seq",
        "state"
      ]
    },
    "TileId": {
      "type": "number"
    },
    "TimedBlessing": {
      "type": "string",
      "enum": [
        "wings",
        "halo",
        "inspiration",
        "spring"
      ],
      "description": "Heaven's blessings, each lasting BLESSING_TURNS rounds (see blessings.ts)."
    },
    "WireCommandResult": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean",
              "const": true
            }
          },
          "required": [
            "ok"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean",
              "const": false
            },
            "code": {
              "anyOf": [
                {
                  "$ref": "#/definitions/GameErrorCode"
                },
                {
                  "$ref": "#/definitions/HostErrorCode"
                }
              ]
            }
          },
          "required": [
            "ok",
            "code"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
